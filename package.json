{
  "name": "webdesktopmcp-monorepo",
  "private": true,
  "version": "0.1.0",
  "description": "Expose Electron / Tauri / Wails desktop apps as WebMCP servers for AI agents",
  "license": "MIT",
  "packageManager": "pnpm@10.32.1",
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ]
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r --filter './packages/**' build",
    "test": "pnpm -r --filter './packages/**' test",
    "typecheck": "pnpm -r --filter './packages/**' typecheck",
    "clean": "pnpm -r exec rm -rf dist node_modules/.cache"
  }
}
