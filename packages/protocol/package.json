{
  "name": "@webdesktopmcp/protocol",
  "version": "0.1.0",
  "description": "Wire protocol and shared types between the WebMCP polyfill (webview) and desktop hosts (Electron/Tauri/Wails)",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "typescript": "^5.9.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jisung-02/webdesktopmcp.git",
    "directory": "packages/protocol"
  },
  "bugs": {
    "url": "https://github.com/jisung-02/webdesktopmcp/issues"
  },
  "homepage": "https://github.com/jisung-02/webdesktopmcp#readme"
}
