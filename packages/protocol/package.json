{
  "name": "@webdesktopmcp/protocol",
  "version": "0.1.0",
  "description": "Wire protocol and shared types between the WebMCP polyfill (webview) and desktop hosts (Electron/Tauri/Wails)",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "typescript": "^5.9.2"
  }
}
