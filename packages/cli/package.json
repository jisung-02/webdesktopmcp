{
  "name": "@webdesktopmcp/cli",
  "version": "0.1.0",
  "description": "stdio shim that connects MCP clients (Claude Desktop, etc.) to a running webdesktopmcp desktop app",
  "license": "MIT",
  "bin": {
    "webdesktopmcp": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
