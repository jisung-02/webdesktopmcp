  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.18.0",
    "@webdesktopmcp/protocol": "workspace:*",
    "@webdesktopmcp/server": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "esbuild": "^0.25.10",
    "typescript": "^5.9.2"
  }
