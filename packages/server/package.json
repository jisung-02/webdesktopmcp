{
  "name": "@webdesktopmcp/server",
  "version": "0.1.0",
  "description": "Framework-agnostic local MCP server for webdesktopmcp hosts: exposes webview-registered WebMCP tools over Streamable HTTP",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.18.0",
    "@webdesktopmcp/protocol": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jisung-02/webdesktopmcp.git",
    "directory": "packages/server"
  },
  "bugs": {
    "url": "https://github.com/jisung-02/webdesktopmcp/issues"
  },
  "homepage": "https://github.com/jisung-02/webdesktopmcp#readme"
}
