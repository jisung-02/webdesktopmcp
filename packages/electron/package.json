{
  "name": "@webdesktopmcp/electron",
  "version": "0.1.0",
  "description": "WebMCP for Electron: expose your app's webview functionality to AI agents via document.modelContext",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "node build.mjs && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test test/*.test.mjs",
    "test:smoke": "electron test/smoke.cjs"
  },
  "dependencies": {
    "@webdesktopmcp/core": "workspace:*",
    "@webdesktopmcp/protocol": "workspace:*",
    "@webdesktopmcp/server": "workspace:*"
  },
  "peerDependencies": {
    "electron": ">=25"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "electron": "^38.2.0",
    "esbuild": "^0.25.10",
    "typescript": "^5.9.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jisung-02/webdesktopmcp.git",
    "directory": "packages/electron"
  },
  "bugs": {
    "url": "https://github.com/jisung-02/webdesktopmcp/issues"
  },
  "homepage": "https://github.com/jisung-02/webdesktopmcp#readme"
}
